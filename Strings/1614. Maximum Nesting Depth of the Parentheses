class Solution {
    public int maxDepth(String s) {
        int left=0;
        int right=0;
        for(char c:s.toCharArray()){
            if(c=='('){
                left++;
                right=Math.max(left,right);
            }
            else if(c==')'){
                left--;
            }
        }
        return right;
    }
}