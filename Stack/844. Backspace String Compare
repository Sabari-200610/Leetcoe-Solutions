class Solution {
    public boolean backspaceCompare(String s, String t) {

        Stack<Character> a = new Stack<>();
        Stack<Character> b = new Stack<>();

        for (char ch : s.toCharArray()) {
            if (ch == '#') {
                if (!a.isEmpty())
                    a.pop();
            }
            
             else {
                a.push(ch);
            }
        }

        for (char ch : t.toCharArray()) {
            if (ch == '#') {
                if (!b.isEmpty())
                    b.pop();
            } 
            else {
                b.push(ch);
            }
        }

        return a.equals(b);
    }
}