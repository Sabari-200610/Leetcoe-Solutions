class Solution {
    public int[] resultArray(int[] nums) {

        int[] first = new int[nums.length];
        int[] second = new int[nums.length];
        int[] arr = new int[nums.length];

        int start = 1;
        int n = 1;

        first[0] = nums[0];
        second[0] = nums[1];

        for (int i = 2; i < nums.length; i++) {

            if (first[start - 1] > second[n - 1]) {
                first[start] = nums[i];
                start++;
            } else {
                second[n] = nums[i];
                n++;
            }
        }

        int k = 0;

        for (int i = 0; i < start; i++) {
            arr[k++] = first[i];
        }

        for (int i = 0; i < n; i++) {
            arr[k++] = second[i];
        }

        return arr;
    }
}