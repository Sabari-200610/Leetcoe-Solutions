class Solution {
    public int minimumDifference(int[] nums, int k) {
        Arrays.sort(nums);
        int minNum=Integer.MAX_VALUE;
        for(int i=0;i+k-1<nums.length;i++){
             int ans=nums[i+k-1]-nums[i];
             minNum=Math.min(minNum,ans);
        }
        return minNum;
    }
}